# Public values only — anything here is inlined into the browser bundle.
# Never put a private key or secret in these variables.

# localnet | devnet | mainnet-beta
VITE_SOLANA_CLUSTER=devnet

# RPC endpoint for the cluster. api.devnet.solana.com is rate-limited;
# use Helius / QuickNode / Alchemy devnet URL for smoother loading.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional. Defaults to the RPC URL with https -> wss.
# VITE_SOLANA_WS_URL=wss://api.devnet.solana.com

# AgentNS program id (declare_id! in programs/agentns/src/lib.rs)
VITE_AGENTNS_PROGRAM_ID=3CZ5JZgJdxX2wt8UbmyP9kkHPmiMnHhnbsUAXWj7XdnD

# Pinata IPFS pinning (server-side only — do NOT prefix with VITE_)
# Get your JWT from https://app.pinata.cloud/keys
PINATA_JWT=your_pinata_jwt_here
